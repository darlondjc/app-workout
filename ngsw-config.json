{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "dados",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/data/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "appData": {
    "versao": "1.14.1",
    "titulo": "Tela de treino mais compacta",
    "novidades": [
      "Os botões Anterior e Próximo ficam sempre visíveis, mesmo com muitas séries: a tela rola por baixo deles.",
      "As séries ficam juntas num card só, e o cronômetro de descanso ocupa uma linha, sem o chip de séries feitas. Com 4 séries, tudo cabe sem rolar na maioria dos celulares."
    ]
  }
}
