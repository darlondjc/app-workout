{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "dados",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/data/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "appData": {
    "versao": "1.3.0",
    "titulo": "Ícone, abertura e atualizações",
    "novidades": [
      "Novo ícone para Android e iPhone e tela de abertura.",
      "Aviso dentro do app quando houver versão nova, com o botão Atualizar.",
      "Tela de Ajustes para atualizar quando quiser e ver o histórico de mudanças."
    ]
  }
}
