{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "dados",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/data/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "appData": {
    "versao": "1.18.1",
    "titulo": "Tela de amigo: abas fixas e estatísticas reorganizadas",
    "novidades": [
      "As abas Timeline e Estatísticas da tela de um amigo agora ficam sempre coladas acima da barra de navegação, sem subir junto com a rolagem.",
      "Nas estatísticas de outra pessoa, o calendário vem primeiro e depois as medalhas, só as conquistadas, em uma lista horizontal e sem a barra de progresso."
    ]
  }
}
