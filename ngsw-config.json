{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "dados",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/data/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "appData": {
    "versao": "1.13.0",
    "titulo": "Adicionar atividade",
    "novidades": [
      "Na tela inicial, o botão + registra uma atividade fora da ficha: corrida, caminhada, futebol, vôlei, beach tennis, tênis, natação ou outra.",
      "Informe duração, distância e esforço, e adicione uma foto se quiser. A atividade vale como o treino do dia e entra na semana, nas medalhas e na timeline."
    ]
  }
}
