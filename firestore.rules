rules_version = '2';

// Cada pessoa lê e grava os próprios dados. Quem está em um grupo com ela (veja `conexoes`) ou é seu amigo mais
// chegado (veja `amizades`) só lê o histórico de treinos e os treinos publicados na timeline, e pode curtir e
// comentar neles. Só os amigos mais chegados leem o que a pessoa escolhe compartilhar (`compartilhado`).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Mesmo identificador para os dois lados da ligação, em qualquer ordem.
    function chave(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Duas pessoas estão em algum grupo em comum quando existe a ligação entre elas.
    function colegas(a, b) {
      return exists(/databases/$(database)/documents/conexoes/$(chave(a, b)));
    }

    // Amizade aceita entre as duas pessoas (os "amigos mais chegados").
    function amigos(a, b) {
      return exists(/databases/$(database)/documents/amizades/$(chave(a, b)))
        && get(/databases/$(database)/documents/amizades/$(chave(a, b))).data.status == 'aceita';
    }

    // Quem pode ver os treinos de `b`: colega de grupo ou amigo mais chegado.
    function contatos(a, b) {
      return colegas(a, b) || amigos(a, b);
    }

    function euOuContato(dono) {
      return logado() && (request.auth.uid == dono || contatos(request.auth.uid, dono));
    }

    function euOuAmigo(dono) {
      return logado() && (request.auth.uid == dono || amigos(request.auth.uid, dono));
    }

    function textoValido(t) {
      return t is string && t.size() >= 1 && t.size() <= 280;
    }

    // Dados privados (fichas, ficha ativa e treino em andamento).
    match /usuarios/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;

      // Histórico de treinos: o dono grava; colegas leem (calendário e estatísticas).
      match /sessoes/{sessaoId} {
        allow write: if logado() && request.auth.uid == uid;
        allow read: if euOuContato(uid);
      }

      // Treinos publicados na timeline.
      match /eventos/{eventoId} {
        allow read: if euOuContato(uid);
        allow create, update: if logado() && request.auth.uid == uid && request.resource.data.autor == request.auth.uid;
        allow delete: if logado() && request.auth.uid == uid;

        match /curtidas/{quem} {
          allow read: if euOuContato(uid);
          allow create: if euOuContato(uid) && quem == request.auth.uid;
          allow delete: if logado() && quem == request.auth.uid;
        }

        match /comentarios/{comentarioId} {
          allow read: if euOuContato(uid);
          allow create: if euOuContato(uid)
            && request.resource.data.autor == request.auth.uid
            && textoValido(request.resource.data.texto);
          // Quem escreveu apaga o próprio comentário; o dono do treino apaga qualquer um.
          allow delete: if logado() && (resource.data.autor == request.auth.uid || request.auth.uid == uid);
        }
      }

      // Foto do treino (JPEG reduzido, em base64), guardada à parte do card para a timeline só baixá-la quando preciso.
      match /fotos/{sessaoId} {
        allow read: if euOuContato(uid);
        allow create, update: if logado() && request.auth.uid == uid
          && request.resource.data.dados is string
          && request.resource.data.dados.size() <= 400000;
        allow delete: if logado() && request.auth.uid == uid;
      }

      // O que a pessoa escolhe mostrar só aos amigos mais chegados (ex.: o gráfico de peso). Apagar o documento
      // corta o acesso.
      match /compartilhado/{item} {
        allow read: if euOuAmigo(uid);
        allow write: if logado() && request.auth.uid == uid;
      }

      // Reações recebidas (curtidas e comentários): só o dono lê; colegas deixam o aviso.
      match /atividades/{atividadeId} {
        allow read, delete: if logado() && request.auth.uid == uid;
        allow create: if logado()
          && request.resource.data.autor == request.auth.uid
          && contatos(request.auth.uid, uid)
          && (!('texto' in request.resource.data) || textoValido(request.resource.data.texto));
        // O aviso de curtida tem id fixo por pessoa e treino: curtir de novo o sobrescreve.
        // Só quem o criou o atualiza.
        allow update: if logado()
          && resource.data.autor == request.auth.uid
          && request.resource.data.autor == request.auth.uid
          && contatos(request.auth.uid, uid)
          && (!('texto' in request.resource.data) || textoValido(request.resource.data.texto));
      }
    }

    // Nome, foto e meta, visíveis a quem estiver logado e souber o identificador.
    match /perfis/{uid} {
      allow get: if logado();
      allow create, update: if logado() && request.auth.uid == uid;
    }

    // Código pessoal -> identificador. Só consulta pontual (get), sem listar, e nunca sobrescreve.
    match /codigos/{codigo} {
      allow get: if logado();
      allow create: if logado() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
    }

    // Pedidos e amizades. O identificador é sempre `chave(uidA, uidB)`.
    match /amizades/{amizadeId} {
      allow read: if logado() && request.auth.uid in resource.data.membros;
      allow create: if logado()
        && request.resource.data.de == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.membros.size() == 2
        && request.resource.data.membros[0] != request.resource.data.membros[1]
        && request.auth.uid in request.resource.data.membros
        && amizadeId == chave(request.resource.data.membros[0], request.resource.data.membros[1]);
      // Só quem recebeu o pedido aceita.
      allow update: if logado()
        && request.auth.uid in resource.data.membros
        && request.auth.uid != resource.data.de
        && resource.data.status == 'pendente'
        && request.resource.data.status == 'aceita'
        && request.resource.data.membros == resource.data.membros
        && request.resource.data.de == resource.data.de;
      allow delete: if logado() && request.auth.uid in resource.data.membros;
    }

    // Grupos. O id é o código do convite: quem o tem consegue ver o grupo (get), mas ninguém lista os grupos dos outros.
    match /grupos/{codigo} {
      function campos(chaves) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(chaves);
      }

      allow get: if logado();
      // Lista os grupos de que a pessoa faz parte e aqueles em que pediu para entrar (a aba Social mostra "aguardando aprovação").
      allow list: if logado() && (request.auth.uid in resource.data.membros || request.auth.uid in resource.data.pedidos);

      allow create: if logado()
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.membros == [request.auth.uid]
        && request.resource.data.pedidos == []
        && request.resource.data.acesso in ['aberto', 'aprovado']
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 1 && request.resource.data.nome.size() <= 40;

      allow update: if logado() && (
        // Entrar por um link aberto.
        (resource.data.acesso == 'aberto'
          && campos(['membros'])
          && !(request.auth.uid in resource.data.membros)
          && request.resource.data.membros.size() == resource.data.membros.size() + 1
          && request.auth.uid in request.resource.data.membros)
        // Pedir para entrar (grupo com aprovação).
        || (campos(['pedidos'])
          && !(request.auth.uid in resource.data.membros)
          && request.resource.data.pedidos.size() == resource.data.pedidos.size() + 1
          && request.auth.uid in request.resource.data.pedidos)
        // Cancelar o próprio pedido.
        || (campos(['pedidos'])
          && request.resource.data.pedidos.size() == resource.data.pedidos.size() - 1
          && !(request.auth.uid in request.resource.data.pedidos))
        // O dono aceita ou recusa pedidos e escolhe quem pode entrar.
        || (request.auth.uid == resource.data.dono
          && campos(['membros', 'pedidos', 'acesso']))
        // O dono troca a imagem do grupo (JPEG pequeno em base64) ou a tira.
        || (request.auth.uid == resource.data.dono
          && campos(['foto'])
          && (!('foto' in request.resource.data)
            || (request.resource.data.foto is string && request.resource.data.foto.size() <= 60000)))
        // Sair do grupo (o dono passa o posto para outro membro).
        || (request.auth.uid in resource.data.membros
          && campos(['membros', 'dono'])
          && !(request.auth.uid in request.resource.data.membros)
          && request.resource.data.membros.size() == resource.data.membros.size() - 1
          && request.resource.data.dono in request.resource.data.membros)
      );

      // Só apaga o grupo quem é a última pessoa nele.
      allow delete: if logado() && resource.data.membros == [request.auth.uid];
    }

    // Ligação entre duas pessoas de um mesmo grupo. O identificador é sempre `chave(uidA, uidB)`.
    match /conexoes/{conexaoId} {
      function grupoComOsDois(codigo, membros) {
        return get(/databases/$(database)/documents/grupos/$(codigo)).data.membros.hasAll(membros);
      }

      // `resource == null`: ler uma ligação que ainda não existe (para criá-la) precisa passar.
      allow get: if logado() && (resource == null || request.auth.uid in resource.data.membros);
      allow list: if logado() && request.auth.uid in resource.data.membros;
      allow create: if logado()
        && request.auth.uid in request.resource.data.membros
        && request.resource.data.membros.size() == 2
        && request.resource.data.membros[0] != request.resource.data.membros[1]
        && conexaoId == chave(request.resource.data.membros[0], request.resource.data.membros[1])
        && request.resource.data.grupos.size() == 1
        && grupoComOsDois(request.resource.data.grupos[0], request.resource.data.membros);
      // Só os dois grupos em comum mudam: incluir (o novo vai por último) exige um grupo com os dois; tirar é livre.
      allow update: if logado()
        && request.auth.uid in resource.data.membros
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grupos'])
        && (request.resource.data.grupos.size() <= resource.data.grupos.size()
          || grupoComOsDois(request.resource.data.grupos[request.resource.data.grupos.size() - 1], resource.data.membros));
      allow delete: if logado() && request.auth.uid in resource.data.membros;
    }
  }
}
